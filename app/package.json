{
  "name": "go-kube-ops-view",
  "version": "1.0.0",
  "description": "Go backend rewrite and tooling modernization of Kubernetes Operational View",
  "main": "src/app.js",
  "config": {
    "buildDir": "../assets/static/build"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prestart": "npm install",
    "start": "NODE_ENV=development webpack --watch --config ./webpack.config.js",
    "startwin": "SET NODE_ENV=development & webpack --watch",
    "webpack": "webpack --config ./webpack.config.js",
    "build": "NODE_ENV=production npm run webpack",
    "buildwin": "SET NODE_ENV=production & npm run webpack",
    "prewebpack": "npm run clean",
    "lint": "eslint ./src --ext .js",
    "clean": "rimraf $npm_package_config_buildDir && mkdir $npm_package_config_buildDir"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MikeTomlin19/go-kube-ops-view.git"
  },
  "author": "",
  "license": "GPL-3.0-only",
  "bugs": {
    "url": "https://github.com/MikeTomlin19/go-kube-ops-view/issues"
  },
  "homepage": "https://github.com/MikeTomlin19/go-kube-ops-view#readme",
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@pixi/filter-crt": "^5.1.1",
    "pixi.js": "^4.8.9"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/plugin-transform-runtime": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "babel-loader": "^10.0.0",
    "eslint": "^8.57.1",
    "rimraf": "^6.1.0",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1"
  }
}
